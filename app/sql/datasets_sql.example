📥 2. INSERT（插入数据集）
sql
-- 插入一个 preset 类型数据集
INSERT INTO datasets (
    id,
    name,
    createdAt,
    sourceDef,
    schema,
    rowCount,
    cache
)
VALUES (
    'ds_abc123',
    'A股全市场3年数据',
    CURRENT_TIMESTAMP,
    '{
        "type": "preset",
        "markets": ["SH", "SZ"],
        "sectors": ["金融", "科技"],
        "universe": "HS300",
        "start": "2022-01-01",
        "end": "2025-01-01"
    }',
    '["date", "symbol", "close", "volume"]',
    1000000,
    '{
        "status": "ready",
        "tableName": "cache_dataset_ds_abc123"
    }'
);
sql
-- 插入一个 SQL 类型
INSERT INTO datasets (
    id, name, createdAt, sourceDef
)
VALUES (
    'ds_sql01',
    'SQL自定义数据集',
    CURRENT_TIMESTAMP,
    '{
        "type": "sql",
        "sql": "SELECT * FROM stock_data WHERE date > ''2023-01-01''"
    }'
);
🔄 3. UPDATE（更新数据集）
3.1 更新基础信息 + 时间
sql
UPDATE datasets
SET
    name = 'A股3年金融科技股',
    rowCount = 1200000,
    createdAt = CURRENT_TIMESTAMP
WHERE id = 'ds_abc123';
3.2 更新 sourceDef（最常用）
sql
UPDATE datasets
SET
    sourceDef = '{
        "type": "preset",
        "markets": ["SH"],
        "sectors": ["金融"],
        "start": "2023-01-01",
        "end": "2025-01-01"
    }'
WHERE id = 'ds_abc123';
3.3 更新缓存状态
sql
UPDATE datasets
SET
    cache = '{"status": "running", "tableName": "cache_temp"}'
WHERE id = 'ds_abc123';
🗑️ 4. DELETE（删除数据集）
4.1 删除单个数据集
sql
DELETE FROM datasets
WHERE id = 'ds_abc123';
4.2 清空所有数据集
sql
DELETE FROM datasets;
🔍 5. SELECT（查询数据集）
5.1 查询所有数据集
sql
SELECT * FROM datasets;
5.2 查询单个数据集
sql
SELECT * FROM datasets WHERE id = 'ds_abc123';
5.3 按类型查询（preset/sql/filters）
sql
SELECT * FROM datasets
WHERE sourceDef->>'type' = 'preset';
5.4 查询缓存就绪的数据集
sql
SELECT * FROM datasets
WHERE cache->>'status' = 'ready';
